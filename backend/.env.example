# Configuración del Servidor
HOST=
PORT=

# SSL/TLS Configuration
USE_SSL=true
SSL_CERT_FILE=ssl_cert.pem
SSL_KEY_FILE=ssl_cert.key

# Seguridad
ADMIN_PASSWORD=
SECRET_KEY=

# CORS - Dominios permitidos (separados por coma)
ALLOWED_ORIGINS=
# RSA Key Size (2048, 3072, 4096)
RSA_KEY_SIZE=

# Ambiente
ENVIRONMENT=
